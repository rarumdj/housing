# ── FRONTEND (Vite) ───────────────────────────────
# Base URL the SPA calls. Defaults to the dev proxy path "/api/v1".
VITE_API_BASE_URL=/api/v1

# Dev server port.
VITE_PORT=5173

# Where the Vite dev proxy forwards "/api" requests.
# Local (non-docker): http://localhost:4000
# Docker compose: http://api:4000
VITE_PROXY_TARGET=http://localhost:4000
