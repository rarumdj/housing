# Copy to .env.docker in the project root (optional overrides for Docker Compose).
# cp .env.docker.example .env.docker
#
# Database connection for the API container is set in docker-compose.yml (DB_HOST=mysql).
# MySQL is exposed on the host at port 3307 so XAMPP can keep using 3306.

MYSQL_ROOT_PASSWORD=root
DATABASE=house_hunt
MYSQL_HOST_PORT=3307
API_HOST_PORT=4000
FRONTEND_HOST_PORT=5173
ADMINER_HOST_PORT=8080
REDIS_HOST_PORT=6379

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

REDIS_URL=redis://redis:6379

CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_PRESET=
CLOUDINARY_CLOUD_NAME=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM=noreply@househunt.ng

TERMII_API_KEY=
TERMII_SENDER_ID=HouseHunt

MONO_SECRET_KEY=

VIDEO_NONCE_SECRET=change_me_nonce
GPS_TOLERANCE_METERS=200
