# Docker Compose env file for the API container (injected via `env_file`).
# Copy to .env.docker (the docker-entrypoint / make target does this for you):
#   cp .env.docker.example .env.docker
#
# These become real environment variables inside the api container, so they
# override anything in backend/.env. DB_HOST=mysql / REDIS point at the compose
# service names. MySQL is exposed on the host at 3307 (compose), 3306 in-network.

# ── APP ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── DATABASE (compose network) ────────────────────
DATABASE=house_hunt
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DIALECT=mysql

# ── REDIS ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CLOUDINARY (unsigned upload preset) ───────────
CLOUDINARY_URL=https://api.cloudinary.com/v1_1/dswmhxqsb/upload
CLOUDINARY_PRESET=house_hunt
CLOUDINARY_CLOUD_NAME=dswmhxqsb
CLOUDINARY_API_KEY=

# ── PAYMENTS ──────────────────────────────────────
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# ── EMAIL (SMTP) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=noreply@househunt.ng

# ── SMS (Termii) ──────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=HouseHunt

# ── MONO (Open Banking) ───────────────────────────
MONO_SECRET_KEY=

# ── VIDEO VERIFICATION ────────────────────────────
VIDEO_NONCE_SECRET=change_me_nonce
GPS_TOLERANCE_METERS=200
